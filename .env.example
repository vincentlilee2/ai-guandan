# ============================================
# Guandan AI · 环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env
# ⚠️ .env 已被 .gitignore 忽略，切勿提交
#
# ⚠️ 值不要加引号！写 BASE_URL=https://api.deepseek.com
#    而不是 BASE_URL="https://api.deepseek.com"
#    python-dotenv 会自动剥引号，但 docker run --env-file 不会，
#    引号会被当作值的一部分，导致 AI 静默降级为本地规则策略。
# ============================================

# --- AI 玩家（必填） -------------------------
# 三个 AI 各自独立配置，可以都用同一个 key。
# 配置变量支持两套命名，新代码优先 *_LLM_*；旧的 *_GEMINI_* 仍兼容（向后兼容，不强制迁移）。
# ⚠️ 变量名中的 GEMINI / LLM 只是历史命名，实际支持任意 OpenAI 兼容端点
#    （DeepSeek / 通义 / Moonshot / 本地 llama.cpp 均可）。
# 示例填的是 DeepSeek；用官方 OpenAI 则留空 BASE_URL 即可。

# 推荐新命名（*_LLM_*），下面每行都给了旧名对照，二选一即可：
PARTNERBOT_LLM_API_KEY=          # 兼容：PARTNERBOT_GEMINI_API_KEY
PARTNERBOT_LLM_BASE_URL=https://api.deepseek.com   # 兼容：PARTNERBOT_GEMINI_BASE_URL
PARTNERBOT_LLM_MODEL=deepseek-chat                # 兼容：PARTNERBOT_GEMINI_MODEL
PARTNERBOT_LLM_TEMPERATURE=0.3                    # 兼容：PARTNERBOT_GEMINI_TEMPERATURE

LEFTBOT_LLM_API_KEY=             # 兼容：LEFTBOT_GEMINI_API_KEY
LEFTBOT_LLM_BASE_URL=https://api.deepseek.com
LEFTBOT_LLM_MODEL=deepseek-chat
LEFTBOT_LLM_TEMPERATURE=0.3

RIGHTBOT_LLM_API_KEY=            # 兼容：RIGHTBOT_GEMINI_API_KEY
RIGHTBOT_LLM_BASE_URL=https://api.deepseek.com
RIGHTBOT_LLM_MODEL=deepseek-chat
RIGHTBOT_LLM_TEMPERATURE=0.3

# 旧命名（仍可用，新命名缺失时回退到此）：
# PARTNERBOT_GEMINI_API_KEY=
# PARTNERBOT_GEMINI_BASE_URL=https://api.deepseek.com
# PARTNERBOT_GEMINI_MODEL=deepseek-chat
# PARTNERBOT_GEMINI_TEMPERATURE=0.3
# LEFTBOT_GEMINI_API_KEY=
# ...（其余角色同理）

# --- 全局兜底（当上面某角色未单独配置时使用） ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=

# --- 赛后 AI 教练（可选） ---------------------
# 复盘阶段「AI 教练」用的模型。推荐 DeepSeek（OpenAI 兼容端点）。
# 新命名 *_LLM_* 优先；旧的 COACH_OPENAI_API_KEY / COACH_MODEL_NAME 作回退。
COACH_LLM_API_KEY=               # 兼容：COACH_OPENAI_API_KEY
COACH_LLM_BASE_URL=https://api.deepseek.com
COACH_LLM_MODEL=deepseek-chat
COACH_LLM_TEMPERATURE=0.2        # 兼容：COACH_MODEL_NAME
# 旧命名（仍可用）：
# COACH_OPENAI_API_KEY=
# COACH_MODEL_NAME=

# --- 会话保护 --------------------------------
GAME_SESSION_TTL_SECONDS=7200        # 空闲对局回收秒数
GAME_MAX_ACTIVE_SESSIONS=200         # 最大并发对局（按内存调整）
GAME_CLEANUP_INTERVAL_SECONDS=300    # 清理轮询间隔

# --- 功能开关（可选，默认开通会员登录） ------------------
# 开关优先在 backend/config.py 里改常量；这里的环境变量用于按部署覆盖：
#   1 = 开通，0 = 关闭。
# 开源单机版：默认关闭会员登录。如要对接创作人官网会员系统，设 ENABLE_MEMBER_LOGIN=1 并填下方 MEMBER_SERVER_URL。
ENABLE_MEMBER_LOGIN=0                # 会员注册/登录（默认关闭，本地单机；=1 且配 MEMBER_SERVER_URL 才转发官网）
ENABLE_AI_COACH=0                    # 复盘 AI 教练（关闭时复盘界面不显示教练入口）

# --- 会员注册/登录（可选） --------------------
# 用户数据目录（users.json/sessions.json/plays.json 存这里）。
# 不配置则默认项目根目录；Docker 部署已自动指向 /app/userdata 挂载卷。
#GAME_USER_DATA_DIR=

# 会员服务器地址。默认留空 = 本地单机模式（账号存本地，离线可跑）。
# 填官网地址 https://guandan.mgarden.org.cn 即开通官网会员（注册/登录/积分/胜率同步到官网）。
# 如需连官网，取消下行注释：
#   留空 = 本地模式：账号数据存本地（见 GAME_USER_DATA_DIR），离线可跑。
# 远程模式下账号数据仅存官网，本地不再生成注册数据（也保证不会误提交到 GitHub）；
# 切勿在 .env 中保存真实密码。
#MEMBER_SERVER_URL=https://guandan.mgarden.org.cn

# ⚠️ 本实例是否为创作人官方网站（账号权威）。【仅官方服务器部署需要 =1】
# 官方实例设 =1：强制「本地账号模式」，绝不把会员请求转发出去，
# 从根源避免「远程转发绕一圈打回自己」的递归（服务器曾实测 10s 超时 + 限流耗尽）。
# 官方服务器 .env 建议：IS_OFFICIAL_SERVER=1 且 MEMBER_SERVER_URL=（留空）。
# 本地实例 / 一般部署：不要设置（保持默认 0 = 远程转发官网）。
#IS_OFFICIAL_SERVER=1

# --- 调试（可选） ----------------------------
GUANDAN_DEBUG_AI=0                   # 1 = 打印 AI 完整思考过程
SHUFFLE_DEBUG=0

# --- 积分持久化（可选，留空则用内存存储） -------
# 三项都填才启用 MySQL。需额外安装：pip install -r requirements-mysql.txt（pymysql）。
# 不装则 score_store 自动降级为内存存储，单机自娱无需配置。
#GAME_DB_HOST=
#GAME_DB_USER=
#GAME_DB_PASS=
#GAME_DB_NAME=

# --- 反向代理集成（可选，进阶） -----------------
# 仅当把本服务放在自有网关之后、由网关注入 X-User-Id 做用户体系时才需要。
# GAME_TRUSTED_PROXY_IPS=127.0.0.1,::1
# GAME_TRUSTED_PROXY_TOKEN=

# --- 对局状态持久化（可选，重启不丢对局）--------
# 默认 memory（进程内，重启清空）。设 GAME_STORE_BACKEND=redis 后，
# 对局/访问 token/meta 持久化到 Redis，重启后前端刷新可恢复继续。
# 需要 redis-py（已在 requirements.txt）；Redis 连不上时自动回退 memory。
# GAME_STORE_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/0
